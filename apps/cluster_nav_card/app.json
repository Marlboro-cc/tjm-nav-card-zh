{
  "id": "cluster_nav_card",
  "title": "TJM 仪表盘导航卡片",
  "description": "在仪表盘地图上显示下一次转向、距离、道路名称和车道提示。可读取手机或宝马原车导航、导航文件，也可演示路线。需要 Waze on cluster 和 cluster-render。Waze 自身不提供转向指引。",
  "version": "0.9.204",
  "vendor": "TJM",
  "loggingId": "OB33",
  "iconGlyph": "navcard",
  "signals": {
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "_optional": "无法读取车机转向指引时，可使用导航文件或演示路线",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "conclusiveDart": "rs",
      "currentLaneGuiding": "rs",
      "nextIntersection": "rs",
      "finalDestinationInfo": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "_optional": "无法判断手机是否发送转向数据",
      "projectedGuidanceMetadataAvailable": "rs",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_instances": "Main_Instance",
      "_optional": "无法诊断手机提供的导航数据",
      "activeRouteChange": "rs",
      "currentRoad": "rs",
      "currentLaneGuiding": "rs",
      "waypoints": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_instances": "Main_Instance",
      "_optional": "无法从车机事件列表读取转向信息",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.navigation.externalize.adasng.CCP": {
      "_instances": "1",
      "_optional": "无法根据车辆所在地区判断环岛通行方向",
      "countryCode": "rs",
      "_broadcasts": [
        "trafficSide"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM 仪表盘导航卡片",
      "buttons": [
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "show",
      "label": "仪表盘卡片",
      "type": "choice",
      "default": "cluster",
      "options": [
        [
          "cluster",
          "导航时叠加在地图上"
        ],
        [
          "off",
          "关闭"
        ]
      ]
    },
    {
      "key": "place",
      "label": "卡片位置",
      "type": "choice",
      "default": "topCenter",
      "options": [
        [
          "topCenter",
          "地图顶部居中"
        ],
        [
          "topLeft",
          "地图左上方"
        ],
        [
          "topRight",
          "地图右上方"
        ]
      ]
    },
    {
      "key": "vpos",
      "label": "卡片高度",
      "type": "choice",
      "default": "badge",
      "options": [
        [
          "badge",
          "车型标识下方"
        ],
        [
          "top",
          "地图顶部"
        ],
        [
          "low",
          "原车转向提示框下方"
        ]
      ]
    },
    {
      "key": "size",
      "label": "卡片大小",
